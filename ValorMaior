//Escreva um programa que lê 3 valores e imprima o valor do maior.
#include <stdio.h>
int main()
{
    int v1, v2, v3;

    printf("digite o primeiro valor:");
    scanf("%d", &v1);

    printf("digite o segundo valor:");
    scanf("%d", &v2);

    printf("digite o terceiro valor:");
    scanf("%d", &v3);
    if(v1>v2 & v1>v3)
    {
        printf("Valor 1 e o maior= %d\n", v1);
    }
    if(v2>v1 & v2>v3)
    {
        printf("valor 2 e o maior= %d\n", v2);
    }
    if(v3>v2 & v3>v1)
    {
        printf("valor 3 e o maior= %d\n", v3);
    }
    if(v1==v2 & v1==v3 & v2==v3)
    {
        printf("valores todos iguais");
    }
} 
