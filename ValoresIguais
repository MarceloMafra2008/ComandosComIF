//Escreva um programa que lei 2 valores e informe se são iguais.            
#include <stdio.h>
int main()
{
    int valor1, valor2;

    printf("digite o primeiro valor:");
    scanf("%d", &valor1);

    printf("digite o segundo valor:");
    scanf("%d", &valor2);

    if(valor1==valor2)
    {
        printf("valores iguais!");
    }
    else
    {
        printf("valores diferentes!");
    }
}     
