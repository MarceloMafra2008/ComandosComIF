#include <stdio.h>
int main()
{
    int num1, num2, op;
    
    printf("\nInsira o priemiro valor:");
    scanf("%d", &num1);
    printf("\nInsira o segundo valor:");
    scanf("%d", &num2);
    
    
    printf("\n|FUNCOES|");
    printf("\n|1 para soma|");
    printf("\n|2 para subt|");
    printf("\n|3 para mult|");
    printf("\n|4 para divi|");

    printf("\nDigite a operacao:");
    scanf("%d", &op);
    
      switch(op)
      {
          case 1: printf("Valor da soma dos numeros %d+%d=%d", num1, num2, num1+num2);   
                  break;
                
          case 2: printf("Valor da subtracao dos numeros %d+%d=%d", num1, num2, num1-num2);
                  break;
                 
          case 3: printf("Valor da multiplicacao %d*%d=%d", num1, num2, num1*num2);
                  break;
                
          case 4:if(num2==0)
                 {
                    printf("!!Divisao incorreta Numero 2 nao pode ser igual a (zero 0)!!");
                 }
                 else
                 {
                    printf("Valor da divisao %d/%d=%f", num1, num2, (float)num1/num2);   
                 }     
                  break;
          
          default: printf("Opcao inserida invalida!");
      }
      
}
